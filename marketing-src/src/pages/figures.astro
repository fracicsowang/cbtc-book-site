---
<Page
  title="Figures Gallery — All 78 CBTC Technical Figures"
  description="All 78 original technical figures from both volumes, organized by chapter — architectures, decision flowcharts, comparison matrices, deployment maps. Drawn from scratch for this work."
  path="figures.html"
  extraCss={["figures.css"]}
  active="figures"
>
  <section class="fg-hero">
    <div class="container">
      <span class="kicker">Figures gallery · all 16 chapters</span>
      <h1 class="fg-h">Every CBTC subsystem, drawn at the level of detail engineers actually need.</h1>
      <p class="fg-lede">All 78 original technical figures from both volumes, organized by chapter. Architectures, decision flowcharts, comparison matrices, deployment maps — drawn from scratch for this work, not lifted from vendor brochures.</p>
      <div class="fg-stats">
        <div class="fg-stat"><span class="num">78</span><span class="lab">figures total</span></div>
        <div class="fg-stat"><span class="num">16</span><span class="lab">chapters covered</span></div>
        <div class="fg-stat"><span class="num">2</span><span class="lab">volumes</span></div>
      </div>
    </div>
  </section>

  <nav class="fg-toc">
    <div class="container">
      <div class="fg-toc-grid">
        <span class="fg-toc-label">Jump to</span>
        <div class="fg-toc-links">
          {FIGS.map((g) => <a href={`#ch${g.ch}`}>CH {g.ch}</a>)}
        </div>
      </div>
    </div>
  </nav>

  {FIGS.map((group) => (
    <section class="fg-section" id={`ch${group.ch}`}>
      <div class="container">
        <div class="fg-section-h">
          <span class="ch">Vol {group.vol} · Chapter {group.ch}</span>
          <h2>{group.title}</h2>
        </div>
        <div class="fg-grid">
          {group.items.map((it) => (
            <a class="fg-card" href={`volume-${group.vol}.html`}>
              <img src={`figures/${it.f}`} alt={it.t} loading="lazy"/>
              <div class="fg-cap">
                <span class="num">Fig {it.n}</span>
                <span class="title">{it.t}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}
</Page>
