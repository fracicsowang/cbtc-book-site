---
import Page from "../layouts/Page.astro";
---
<Page
  title="Contact — Chunjun (Francisco) Wang"
  description="Contact Chunjun Wang for CBTC consulting, speaking engagements, guest lectures, or bulk orders. Open to remote and flex US-based work."
  path="contact.html"
  extraCss={["contact.css"]}
  active="contact"
>
  <section class="contact-hero">
    <div class="container contact-grid">
      <div>
        <span class="kicker">Contact · Speaking · Consulting</span>
        <h1 class="contact-h">Open to remote and flex US-based work — and to talking about CBTC.</h1>
        <p class="contact-lede">If you're a transit agency, vendor, or program team with a CBTC question — or a recruiter / hiring manager looking at my background — the fastest channel is email. Speaking and guest-lecture inquiries also welcome.</p>
        <div class="contact-modes">
          <div class="contact-mode">
            <div class="contact-mode-icon">✉</div>
            <div>
              <h3>Email</h3>
              <p>Best for project inquiries, errata, and most everything else.</p>
            </div>
            <a href="mailto:franciscowang2008@gmail.com">franciscowang2008@gmail.com</a>
          </div>
          <div class="contact-mode">
            <div class="contact-mode-icon">↗</div>
            <div>
              <h3>LinkedIn</h3>
              <p>Full work history, recommendations, and the most recent updates.</p>
            </div>
            <a href="https://www.linkedin.com/in/chunjun-wang/" target="_blank" rel="noopener">linkedin.com/in/chunjun-wang</a>
          </div>
          <div class="contact-mode">
            <div class="contact-mode-icon">◆</div>
            <div>
              <h3>Speaking &amp; lectures</h3>
              <p>Available for guest lectures, conference panels, and agency tech-talks on CBTC and US deployment practice.</p>
            </div>
            <a href="mailto:franciscowang2008@gmail.com?subject=Speaking%20inquiry">Email about speaking →</a>
          </div>
          <div class="contact-mode">
            <div class="contact-mode-icon">▦</div>
            <div>
              <h3>Bulk / institutional orders</h3>
              <p>Library, classroom, or agency-wide copies — both volumes available with discount on quantity.</p>
            </div>
            <a href="mailto:franciscowang2008@gmail.com?subject=Bulk%20order">Email about bulk →</a>
          </div>
        </div>
      </div>
      <div>
        <div class="contact-card">
          <img class="contact-card-photo" src="assets/headshot.jpg" alt="Chunjun (Francisco) Wang"/>
          <h4>The author</h4>
          <h2 class="contact-card-name">Chunjun (Francisco) Wang</h2>
          <p class="contact-card-tag">Booth MBA · CFA · CBTC Rail-Tech Expert</p>
          <p>Twenty years in rail signaling — engineering design, system integration, and operating responsibility for an international rail-signaling group's US subsidiary. Currently Senior Research Engineer at Rutgers University CAIT, researching applied AI for rail and energy infrastructure.</p>
          <p>Open to remote or flexible US roles. Comfortable in English and Mandarin.</p>
          <div class="contact-card-meta">
            <div>📍 Princeton, NJ</div>
            <div>⊙ Open to remote / flex US</div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Page>
