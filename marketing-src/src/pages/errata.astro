---
import Page from "../layouts/Page.astro";
const monoLabel = "font-family:var(--mono);font-size:10px;letter-spacing:1.4px;text-transform:uppercase;color:var(--char-dim);margin-bottom:8px";
---
<Page
  title="Errata & Supplements — CBTC (Vol 1 & 2)"
  description="Errata, corrections, and supplementary downloads for Communications-Based Train Control by Chunjun (Francisco) Wang."
  path="errata.html"
  extraCss={["errata.css"]}
  active="errata"
>
  <section class="err-hero">
    <div class="container">
      <span class="kicker">Errata · Supplements · Reader resources</span>
      <h1 class="err-h">Corrections and downloadable supplements for both volumes.</h1>
      <p class="err-lede">A book this size will have errata. This page is the canonical, dated record — checked weekly. Supplements include the full chapter outlines, figure source files, and bibliography.</p>
    </div>
  </section>

  <section class="err-section">
    <div class="container">
      <h2>Volume 1 — Errata</h2>
      <div class="err-empty">No errata reported yet. Volume 1 published April 2026.<br/>Spotted something? Use the report form below — every confirmed correction is credited here.</div>
    </div>
  </section>

  <section class="err-section">
    <div class="container">
      <h2>Volume 2 — Errata</h2>
      <div class="err-empty">No errata reported yet. Volume 2 published April 2026.</div>
    </div>
  </section>

  <section class="err-section">
    <div class="container">
      <h2>Downloadable supplements</h2>
      <div class="supp-grid">
        <div class="supp-card">
          <div style={monoLabel}>PDF · 18 pp</div>
          <h4>Full chapter outline</h4>
          <p>Section-by-section breakdown of all sixteen chapters across both volumes. Useful for procurement reviewers deciding which volume to cite.</p>
          <a href="#">Download PDF →</a>
        </div>
        <div class="supp-card">
          <div style={monoLabel}>SVG bundle</div>
          <h4>Figure source files</h4>
          <p>All system schematics from the book in editable SVG, licensed for non-commercial classroom and proposal use.</p>
          <a href="#">Download bundle →</a>
        </div>
        <div class="supp-card">
          <div style={monoLabel}>BibTeX · CSV</div>
          <h4>Bibliography</h4>
          <p>Full reference list with DOIs, organized by chapter. Drop into Zotero / Mendeley / your proposal manager of choice.</p>
          <a href="#">Download →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="err-section">
    <div class="container">
      <div class="report-box">
        <h3>Report an erratum</h3>
        <p>Email the volume, page number, and a one-line description. Confirmed corrections are credited on this page (with attribution if you'd like) and rolled into the next print run.</p>
        <a class="btn btn-primary" style="background:var(--amber);border-color:var(--amber);color:var(--navy)" href="mailto:franciscowang2008@gmail.com?subject=CBTC%20Errata%20Report">Email errata →</a>
      </div>
    </div>
  </section>
</Page>
